# ─── Chain (Base Sepolia) ─────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Testnet USDC on Base Sepolia (Circle)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ─── Agent (buyer) wallet ────────────────────────────────────────────
# Needs Base Sepolia USDC (https://faucet.circle.com) and a little ETH for markPaid gas.
AGENT_PRIVATE_KEY=0x...

# ─── Contract ─────────────────────────────────────────────────────────
# Deployer / invoice issuer key (can equal AGENT_PRIVATE_KEY for the demo)
DEPLOYER_PRIVATE_KEY=0x...
# Filled in after `forge script` deploy
INVOICE_TOKEN_ADDRESS=

# ─── Seller (x402 resource server) ───────────────────────────────────
SELLER_PORT=4021
SELLER_URL=http://localhost:4021
X402_FACILITATOR_URL=https://x402.org/facilitator
# Clean supplier that receives testnet USDC in scenarios 1 and 3
CLEAN_SUPPLIER_ADDRESS=0x...

# ─── Intercepta (Web3 Antivirus) API ─────────────────────────────────
# Request a key: https://docs.web3antivirus.io/reference/getting-started-1
INTERCEPTA_API_KEY=
INTERCEPTA_BASE_URL=https://api.web3antivirus.io
# Screening uses mainnet intelligence: testnet assets are mapped to their mainnet equivalents.
INTERCEPTA_CHAIN_ID=8453
# Known-risky MAINNET address used as payTo in scenario 2 (paste from Intercepta Discord)
RISKY_SUPPLIER_ADDRESS=0x...

# ─── Policy ───────────────────────────────────────────────────────────
# Auto-pay limit in USDC; above this a fresh World ID approval is required
AUTO_PAY_LIMIT_USDC=1.00
# Tightened limit when screening returns CAUTION (CAP verdict)
CAP_LIMIT_USDC=0.10

# ─── World ID for Agents (OIDC, sandbox) ─────────────────────────────
WORLD_ISSUER=https://sandbox.auth.world.org
# mock = local issuer that signs RS256 id_tokens, verified by the same backend verifier
# oidc = real device-authorization grant against WORLD_ISSUER
WORLD_MODE=mock
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# How long a human has to approve before the request expires (seconds)
WORLD_APPROVAL_TTL_SECONDS=90
# An approval's auth_time must be at most this old when the payment executes (seconds)
WORLD_MAX_AUTH_AGE_SECONDS=300

# ─── Agent API (dashboard backend) ───────────────────────────────────
AGENT_PORT=4000
